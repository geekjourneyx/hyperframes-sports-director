{
  "kind": "sport",
  "id": "trail-running",
  "maturity": "experimental",
  "policies": {
    "journeyGrammar": { "stages": ["prepare", "depart", "move", "effort", "observe", "arrive", "return"], "continuityRequirements": ["gait-continuity", "terrain-transition"] },
    "cameraRoleWeights": { "pov": 4, "front": 2, "rear": 1, "side": 3, "overhead": 1, "low": 2, "ground": 0, "detail": 3, "portrait": 1, "wide": 3, "unknown": 0 },
    "speedPolicy": { "maximumMontageRate": 9, "allowedTreatments": ["gentle-speed-ramp"], "rejectedTreatments": ["terrain-risk-obscuring"] },
    "stabilizationPolicy": { "mode": "conservative", "maximumCropFraction": 0.07 },
    "duplicatePolicy": { "minimumSeparationSeconds": 12, "preferAlternateCameraRole": true },
    "audioPolicy": { "protect": ["breathing", "footfall", "terrain-ambience"], "musicDucking": "required-under-speech" },
    "dataPolicy": { "gps": { "permitted": true, "required": false }, "primaryMetrics": ["distance", "elevationGain", "movingTime"] },
    "visualPolicy": { "footagePrimacy": true, "emphasis": ["terrain", "cadence", "effort"] }
  }
}
