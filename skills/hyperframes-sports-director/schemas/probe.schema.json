{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/probe.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "media", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/probe.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 1 },
    "media": { "type": "array", "items": { "$ref": "#/$defs/media" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableString": { "type": ["string", "null"] },
    "stream": { "type": "object", "required": ["streamId", "type", "codec", "timeBase"], "additionalProperties": false, "properties": { "streamId": { "type": "string", "minLength": 1 }, "type": { "enum": ["video", "audio", "subtitle", "data"] }, "codec": { "type": "string", "minLength": 1 }, "timeBase": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" }, "frameRate": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "rotationDegrees": { "type": "integer", "minimum": 0, "exclusiveMaximum": 360 }, "pixelFormat": { "$ref": "#/$defs/nullableString" }, "colorSpace": { "$ref": "#/$defs/nullableString" }, "colorPrimaries": { "$ref": "#/$defs/nullableString" }, "colorTransfer": { "$ref": "#/$defs/nullableString" }, "colorRange": { "$ref": "#/$defs/nullableString" }, "sampleAspectRatio": { "anyOf": [{ "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" }, { "type": "null" }] }, "channels": { "type": "integer", "minimum": 1 }, "sampleRate": { "type": "integer", "minimum": 1 }, "channelLayout": { "type": "string", "minLength": 1 } } },
    "timeMapping": { "type": "object", "required": ["proxyStartSeconds", "originalStartSeconds", "durationSeconds", "rate"], "additionalProperties": false, "properties": { "proxyStartSeconds": { "type": "number", "minimum": 0 }, "originalStartSeconds": { "type": "number", "minimum": 0 }, "durationSeconds": { "type": ["number", "null"], "minimum": 0 }, "rate": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" } } },
    "transform": { "type": "object", "required": ["codec", "maximumWidth", "maximumHeight", "watermark", "preserveTimestamps", "preserveAudio", "autoOrient"], "additionalProperties": false, "properties": { "codec": { "type": "string", "minLength": 1 }, "maximumWidth": { "type": ["integer", "null"], "minimum": 1 }, "maximumHeight": { "type": ["integer", "null"], "minimum": 1 }, "watermark": { "type": ["string", "null"] }, "preserveTimestamps": { "type": "boolean" }, "preserveAudio": { "type": "boolean" }, "autoOrient": { "type": "boolean" } } },
    "proxy": { "type": ["object", "null"], "required": ["kind", "path", "sourceDigest", "transform", "timeMapping"], "additionalProperties": false, "properties": { "kind": { "enum": ["video", "image", "audio"] }, "path": { "$ref": "#/$defs/path" }, "sourceDigest": { "$ref": "#/$defs/digest" }, "transform": { "$ref": "#/$defs/transform" }, "timeMapping": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/timeMapping" } } } },
    "media": { "type": "object", "required": ["mediaId", "mediaType", "reviewPath", "sourceDigest", "byteSize", "durationSeconds", "streams", "captureTimestamp"], "additionalProperties": false, "properties": { "mediaId": { "type": "string", "pattern": "^media-[a-zA-Z0-9-]+$" }, "mediaType": { "enum": ["video", "image", "audio"] }, "reviewPath": { "$ref": "#/$defs/path" }, "sourceDigest": { "$ref": "#/$defs/digest" }, "byteSize": { "type": "integer", "minimum": 0 }, "durationSeconds": { "type": ["number", "null"], "minimum": 0 }, "streams": { "type": "array", "items": { "$ref": "#/$defs/stream" } }, "captureTimestamp": { "type": ["string", "null"], "format": "date-time" }, "proxy": { "$ref": "#/$defs/proxy" } } },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } } } }
  }
}
