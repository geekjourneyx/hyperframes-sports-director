{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/motion-map.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "motionRevision", "status", "designRevision", "assetRevision", "owners", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/motion-map.schema.json" },
    "schemaVersion": { "const": "1.0.0" }, "revision": { "type": "integer", "minimum": 1 },
    "motionRevision": { "type": "string", "pattern": "^motion-[a-zA-Z0-9-]+$" },
    "status": { "enum": ["draft", "available", "frozen", "superseded"] },
    "designRevision": { "type": "string", "pattern": "^design-[a-zA-Z0-9-]+$" },
    "assetRevision": { "type": "string", "pattern": "^assets-[a-zA-Z0-9-]+$" },
    "owners": { "type": "array", "items": { "type": "object", "required": ["ownerId", "assetId", "primitive", "entryFrames", "holdFrames", "exitFrames", "colorToken"], "additionalProperties": false, "properties": { "ownerId": { "type": "string", "pattern": "^owner-[a-zA-Z0-9-]+$" }, "assetId": { "type": "string", "pattern": "^asset-[a-zA-Z0-9-]+$" }, "primitive": { "type": "string", "minLength": 1 }, "entryFrames": { "type": "integer", "minimum": 0 }, "holdFrames": { "type": "integer", "minimum": 0 }, "exitFrames": { "type": "integer", "minimum": 0 }, "colorToken": { "type": "string", "pattern": "^color\\.[a-z][A-Za-z0-9]*$" } } } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } } } } }
}
