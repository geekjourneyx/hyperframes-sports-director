{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/shot.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "status", "shots", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/shot.schema.json" }, "schemaVersion": { "const": "1.0.0" }, "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["unavailable", "available"] }, "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } }, "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quality": { "type": "object", "required": ["motionIntensity", "blur", "shake", "exposure", "horizon", "occlusion"], "additionalProperties": false, "properties": { "motionIntensity": { "enum": ["low", "medium", "high", "unknown"] }, "blur": { "enum": ["none", "minor", "severe", "unknown"] }, "shake": { "enum": ["none", "minor", "severe", "unknown"] }, "exposure": { "enum": ["good", "mixed", "poor", "unknown"] }, "horizon": { "enum": ["level", "tilted", "unknown"] }, "occlusion": { "enum": ["none", "partial", "severe", "unknown"] } } },
    "continuity": { "type": "object", "required": ["screenDirection", "motionDirection", "subjectEntry", "subjectExit", "location", "timeRelation"], "additionalProperties": false, "properties": { "screenDirection": { "enum": ["left-to-right", "right-to-left", "static", "unknown"] }, "motionDirection": { "enum": ["forward", "backward", "left", "right", "static", "unknown"] }, "subjectEntry": { "enum": ["left", "right", "center", "none", "unknown"] }, "subjectExit": { "enum": ["left", "right", "center", "none", "unknown"] }, "location": { "type": "string", "minLength": 1, "maxLength": 120 }, "timeRelation": { "enum": ["continuous", "later", "earlier", "unknown"] } } },
    "audioSpan": { "type": "object", "required": ["kind", "sourceInSeconds", "sourceOutSeconds"], "additionalProperties": false, "properties": { "kind": { "enum": ["speech", "music", "ambient", "unknown"] }, "sourceInSeconds": { "type": "number", "minimum": 0 }, "sourceOutSeconds": { "type": "number", "exclusiveMinimum": 0 } } },
    "shot": { "type": "object", "required": ["shotId", "mediaId", "segmentId", "sourceDigest", "sourceInSeconds", "sourceOutSeconds", "sourceDurationSeconds", "cameraRole", "actionRole", "environmentTags", "subjectTags", "quality", "continuity", "audioSpans", "duplicateGroup", "setupTailLikelihood", "evidenceFrames", "confidence"], "additionalProperties": false, "properties": { "shotId": { "type": "string", "pattern": "^shot-[a-zA-Z0-9-]+$" }, "mediaId": { "type": "string", "pattern": "^media-[a-zA-Z0-9-]+$" }, "segmentId": { "type": "string", "pattern": "^segment-[a-zA-Z0-9-]+$" }, "sourceDigest": { "$ref": "#/$defs/digest" }, "sourceInSeconds": { "type": "number", "minimum": 0 }, "sourceOutSeconds": { "type": "number", "exclusiveMinimum": 0 }, "sourceDurationSeconds": { "type": "number", "exclusiveMinimum": 0 }, "cameraRole": { "enum": ["pov", "front", "rear", "side", "overhead", "low", "ground", "detail", "portrait", "wide", "unknown"] }, "actionRole": { "enum": ["prepare", "depart", "move", "effort", "observe", "hydrate", "pause", "push", "arrive", "return", "other", "unknown"] }, "environmentTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }, "subjectTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }, "quality": { "$ref": "#/$defs/quality" }, "continuity": { "$ref": "#/$defs/continuity" }, "audioSpans": { "type": "array", "items": { "$ref": "#/$defs/audioSpan" } }, "duplicateGroup": { "type": ["string", "null"], "pattern": "^duplicate-[a-zA-Z0-9-]+$" }, "setupTailLikelihood": { "type": "number", "minimum": 0, "maximum": 1 }, "evidenceFrames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": false, "properties": { "probe": { "$ref": "#/$defs/digest" }, "segments": { "$ref": "#/$defs/digest" } } } } }
  }
}
