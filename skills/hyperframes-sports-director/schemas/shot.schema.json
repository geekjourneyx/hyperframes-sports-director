{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/shot.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "status", "shots", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/shot.schema.json" }, "schemaVersion": { "const": "1.0.0" }, "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["unavailable", "available"] }, "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } }, "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "shot": { "type": "object", "required": ["shotId", "mediaId", "sourceInSeconds", "sourceOutSeconds", "sourceDurationSeconds", "evidenceFrames", "confidence"], "additionalProperties": false, "properties": { "shotId": { "type": "string", "pattern": "^shot-[a-zA-Z0-9-]+$" }, "mediaId": { "type": "string", "pattern": "^media-[a-zA-Z0-9-]+$" }, "sourceInSeconds": { "type": "number", "minimum": 0 }, "sourceOutSeconds": { "type": "number", "exclusiveMinimum": 0 }, "sourceDurationSeconds": { "type": "number", "minimum": 0 }, "evidenceFrames": { "type": "array", "items": { "$ref": "#/$defs/path" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } } } }
  }
}
