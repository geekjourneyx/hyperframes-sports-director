{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/look-profile.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "lookRevision", "status", "approvalDigest", "lifecycle", "input", "working", "output", "adjustments", "shotMatchingPolicy", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/look-profile.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 1 },
    "lookRevision": { "type": "string", "pattern": "^look-[a-zA-Z0-9-]+$" },
    "status": { "$ref": "#/$defs/status" },
    "approvalDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "lifecycle": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/lifecycleEntry" } },
    "input": { "type": "object", "required": ["interpretation"], "additionalProperties": false, "properties": { "interpretation": { "enum": ["source-metadata", "rec709"] } } },
    "working": { "type": "object", "required": ["colorSpace"], "additionalProperties": false, "properties": { "colorSpace": { "const": "linear-rec709" } } },
    "output": { "type": "object", "required": ["colorSpace"], "additionalProperties": false, "properties": { "colorSpace": { "const": "rec709-sdr" } } },
    "adjustments": { "type": "object", "required": ["whiteBalance", "exposure", "contrast", "saturation", "highlightProtection"], "additionalProperties": false, "properties": { "whiteBalance": { "type": "number" }, "exposure": { "type": "number" }, "contrast": { "type": "number" }, "saturation": { "type": "number", "minimum": 0 }, "highlightProtection": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "shotMatchingPolicy": { "enum": ["conservative", "balanced"] },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "status": { "enum": ["draft", "proposed", "approved", "frozen", "superseded"] },
    "lifecycleEntry": { "type": "object", "required": ["status", "at"], "additionalProperties": false, "properties": { "status": { "$ref": "#/$defs/status" }, "at": { "type": "string", "format": "date-time" } } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } } } }
  }
}
