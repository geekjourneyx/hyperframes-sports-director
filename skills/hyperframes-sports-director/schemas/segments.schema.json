{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/segments.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "sourceMediaIds", "segments", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/segments.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 1 },
    "sourceMediaIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^media-[a-zA-Z0-9-]+$" } },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceFrame": { "type": "object", "required": ["path", "sourceTimeSeconds"], "additionalProperties": false, "properties": { "path": { "$ref": "#/$defs/path" }, "sourceTimeSeconds": { "type": "number", "minimum": 0 } } },
    "segment": { "type": "object", "required": ["segmentId", "mediaId", "mediaType", "sourceDigest", "probeDigest", "sourceInSeconds", "sourceOutSeconds", "sourceDurationSeconds", "sceneScore", "motionScore", "audioPresent", "reviewPath", "evidenceFrames"], "additionalProperties": false, "properties": { "segmentId": { "type": "string", "pattern": "^segment-[a-zA-Z0-9-]+$" }, "mediaId": { "type": "string", "pattern": "^media-[a-zA-Z0-9-]+$" }, "mediaType": { "enum": ["video", "image"] }, "sourceDigest": { "$ref": "#/$defs/digest" }, "probeDigest": { "$ref": "#/$defs/digest" }, "sourceInSeconds": { "type": "number", "minimum": 0 }, "sourceOutSeconds": { "type": "number", "exclusiveMinimum": 0 }, "sourceDurationSeconds": { "type": "number", "exclusiveMinimum": 0 }, "sceneScore": { "type": "number", "minimum": 0, "maximum": 1 }, "motionScore": { "type": "number", "minimum": 0, "maximum": 1 }, "audioPresent": { "type": "boolean" }, "reviewPath": { "$ref": "#/$defs/path" }, "evidenceFrames": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/evidenceFrame" } } } },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": false, "properties": { "probe": { "$ref": "#/$defs/digest" } } } } }
  }
}
