{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/activity.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "status", "metrics", "availability", "coverage", "reasons", "sources", "sportProfiles", "route", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/activity.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["unavailable", "available"] },
    "metrics": { "$ref": "#/$defs/metrics" },
    "availability": { "$ref": "#/$defs/availability" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "reasons": { "$ref": "#/$defs/reasons" },
    "sources": { "$ref": "#/$defs/sources" },
    "sportProfiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["cycling", "hiking", "pool-swimming", "running", "technical-mountaineering", "trail-running", "open-water-swimming"] } },
    "route": { "$ref": "#/$defs/route" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "metrics": {
      "type": "object",
      "required": ["averageHeartRate", "distance", "movingTime", "averageSpeed", "elevationGain", "averagePower", "averageCadence", "averageTemperature", "pace", "pauseTime", "calories", "gradeDistribution"],
      "additionalProperties": false,
      "properties": {
        "averageHeartRate": { "$ref": "#/$defs/scalar" }, "distance": { "$ref": "#/$defs/scalar" }, "movingTime": { "$ref": "#/$defs/scalar" }, "averageSpeed": { "$ref": "#/$defs/scalar" }, "elevationGain": { "$ref": "#/$defs/scalar" },
        "averagePower": { "$ref": "#/$defs/scalar" }, "averageCadence": { "$ref": "#/$defs/scalar" }, "averageTemperature": { "type": ["number", "null"] }, "pace": { "$ref": "#/$defs/scalar" }, "pauseTime": { "$ref": "#/$defs/scalar" }, "calories": { "$ref": "#/$defs/scalar" },
        "gradeDistribution": { "anyOf": [{ "type": "null" }, { "type": "object", "required": ["flat", "climb", "descent", "analyzedDistanceMeters"], "additionalProperties": false, "properties": { "flat": { "type": "number", "minimum": 0, "maximum": 1 }, "climb": { "type": "number", "minimum": 0, "maximum": 1 }, "descent": { "type": "number", "minimum": 0, "maximum": 1 }, "analyzedDistanceMeters": { "type": "number", "exclusiveMinimum": 0 } } }] }
      }
    },
    "availability": { "type": "object", "required": ["heartRate", "distance", "movingTime", "speed", "elevationGain", "power", "cadence", "temperature", "pace", "pauseTime", "calories", "gradeDistribution", "route"], "additionalProperties": false, "properties": { "heartRate": { "$ref": "#/$defs/status" }, "distance": { "$ref": "#/$defs/status" }, "movingTime": { "$ref": "#/$defs/status" }, "speed": { "$ref": "#/$defs/status" }, "elevationGain": { "$ref": "#/$defs/status" }, "power": { "$ref": "#/$defs/status" }, "cadence": { "$ref": "#/$defs/status" }, "temperature": { "$ref": "#/$defs/status" }, "pace": { "$ref": "#/$defs/status" }, "pauseTime": { "$ref": "#/$defs/status" }, "calories": { "$ref": "#/$defs/status" }, "gradeDistribution": { "$ref": "#/$defs/status" }, "route": { "$ref": "#/$defs/status" } } },
    "coverage": { "type": "object", "required": ["heartRate", "distance", "movingTime", "speed", "elevationGain", "power", "cadence", "temperature", "pace", "pauseTime", "calories", "gradeDistribution", "route"], "additionalProperties": false, "properties": { "heartRate": { "$ref": "#/$defs/coverageValue" }, "distance": { "$ref": "#/$defs/coverageValue" }, "movingTime": { "$ref": "#/$defs/coverageValue" }, "speed": { "$ref": "#/$defs/coverageValue" }, "elevationGain": { "$ref": "#/$defs/coverageValue" }, "power": { "$ref": "#/$defs/coverageValue" }, "cadence": { "$ref": "#/$defs/coverageValue" }, "temperature": { "$ref": "#/$defs/coverageValue" }, "pace": { "$ref": "#/$defs/coverageValue" }, "pauseTime": { "$ref": "#/$defs/coverageValue" }, "calories": { "$ref": "#/$defs/coverageValue" }, "gradeDistribution": { "$ref": "#/$defs/coverageValue" }, "route": { "$ref": "#/$defs/coverageValue" } } },
    "reasons": { "type": "object", "required": ["heartRate", "distance", "movingTime", "speed", "elevationGain", "power", "cadence", "temperature", "pace", "pauseTime", "calories", "gradeDistribution", "route"], "additionalProperties": false, "properties": { "heartRate": { "$ref": "#/$defs/reason" }, "distance": { "$ref": "#/$defs/reason" }, "movingTime": { "$ref": "#/$defs/reason" }, "speed": { "$ref": "#/$defs/reason" }, "elevationGain": { "$ref": "#/$defs/reason" }, "power": { "$ref": "#/$defs/reason" }, "cadence": { "$ref": "#/$defs/reason" }, "temperature": { "$ref": "#/$defs/reason" }, "pace": { "$ref": "#/$defs/reason" }, "pauseTime": { "$ref": "#/$defs/reason" }, "calories": { "$ref": "#/$defs/reason" }, "gradeDistribution": { "$ref": "#/$defs/reason" }, "route": { "$ref": "#/$defs/reason" } } },
    "sources": { "type": "object", "required": ["heartRate", "distance", "movingTime", "speed", "elevationGain", "power", "cadence", "temperature", "pace", "pauseTime", "calories", "gradeDistribution", "route"], "additionalProperties": false, "properties": { "heartRate": { "$ref": "#/$defs/source" }, "distance": { "$ref": "#/$defs/source" }, "movingTime": { "$ref": "#/$defs/source" }, "speed": { "$ref": "#/$defs/source" }, "elevationGain": { "$ref": "#/$defs/source" }, "power": { "$ref": "#/$defs/source" }, "cadence": { "$ref": "#/$defs/source" }, "temperature": { "$ref": "#/$defs/source" }, "pace": { "$ref": "#/$defs/source" }, "pauseTime": { "$ref": "#/$defs/source" }, "calories": { "$ref": "#/$defs/source" }, "gradeDistribution": { "$ref": "#/$defs/source" }, "route": { "$ref": "#/$defs/source" } } },
    "route": { "type": "object", "required": ["status", "trimmedRouteId", "pointCount", "points"], "additionalProperties": false, "properties": { "status": { "$ref": "#/$defs/status" }, "trimmedRouteId": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^trimmed-route-[0-9a-f]{16}$" }] }, "pointCount": { "type": "integer", "minimum": 0 }, "points": { "type": "array", "items": { "type": "object", "required": ["latitude", "longitude", "distanceMeters"], "additionalProperties": false, "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 }, "distanceMeters": { "type": "number", "minimum": 0 }, "timestamp": { "type": "string", "format": "date-time" } } } } } },
    "scalar": { "type": ["number", "null"], "minimum": 0 },
    "status": { "enum": ["available", "unavailable"] },
    "coverageValue": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reason": { "type": ["string", "null"] },
    "source": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^(?:activity-source-[a-zA-Z0-9-]+(?:,activity-source-[a-zA-Z0-9-]+)*|activity-[a-zA-Z0-9-]+:[a-zA-Z0-9-]+)$" }] },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } } } }
  }
}
