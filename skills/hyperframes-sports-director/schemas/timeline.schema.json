{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperframes.local/schemas/timeline.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "revision", "timelineRevision", "status", "phase", "designRevision", "lookRevision", "assetRevision", "motionRevision", "sourceProbeDigest", "items", "integrity"],
  "properties": {
    "$schema": { "const": "https://hyperframes.local/schemas/timeline.schema.json" },
    "schemaVersion": { "const": "1.0.0" }, "revision": { "type": "integer", "minimum": 1 },
    "timelineRevision": { "type": "string", "pattern": "^timeline-[a-zA-Z0-9-]+$" },
    "status": { "enum": ["draft", "available", "frozen", "superseded"] }, "phase": { "enum": ["rough", "final"] },
    "designRevision": { "type": "string", "pattern": "^design-[a-zA-Z0-9-]+$" }, "lookRevision": { "type": "string", "pattern": "^look-[a-zA-Z0-9-]+$" },
    "assetRevision": { "type": "string", "pattern": "^assets-[a-zA-Z0-9-]+$" }, "motionRevision": { "type": "string", "pattern": "^motion-[a-zA-Z0-9-]+$" },
    "sourceProbeDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "music": { "$ref": "#/$defs/music" },
    "warningDecisions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/warningDecision" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "sourceReference": { "type": "object", "required": ["kind", "path", "digest"], "additionalProperties": false, "properties": { "kind": { "enum": ["proxy", "original"] }, "path": { "$ref": "#/$defs/path" }, "digest": { "$ref": "#/$defs/digest" } } },
    "speedPoint": { "type": "object", "required": ["sourceTimeSeconds", "rate"], "additionalProperties": false, "properties": { "sourceTimeSeconds": { "type": "number", "minimum": 0 }, "rate": { "type": "number", "exclusiveMinimum": 0 } } },
    "stabilization": { "type": "object", "required": ["mode", "cropFraction"], "additionalProperties": false, "properties": { "mode": { "enum": ["off", "minimal", "conservative"] }, "cropFraction": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "cropReframe": { "type": ["object", "null"], "required": ["x", "y", "width", "height"], "additionalProperties": false, "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } },
    "stillMotion": { "type": ["object", "null"], "required": ["mode", "holdSeconds", "startScale", "endScale"], "additionalProperties": false, "properties": { "mode": { "enum": ["hold", "panzoom"] }, "holdSeconds": { "type": "number", "exclusiveMinimum": 0 }, "startScale": { "type": "number", "minimum": 1 }, "endScale": { "type": "number", "minimum": 1 } } },
    "transform": { "type": "object", "required": ["stabilization", "cropReframe", "stillMotion", "draftColorTransform", "faceTreatment"], "additionalProperties": false, "properties": { "stabilization": { "$ref": "#/$defs/stabilization" }, "cropReframe": { "$ref": "#/$defs/cropReframe" }, "stillMotion": { "$ref": "#/$defs/stillMotion" }, "draftColorTransform": { "type": "string", "minLength": 1 }, "faceTreatment": { "enum": ["off", "subtle-reviewed"] }, "severeShakeDisposition": { "enum": ["exclude", "stabilize-reviewed"] } } },
    "audioPolicy": { "type": "object", "required": ["sourceGainDb", "denoise", "bridge"], "additionalProperties": false, "properties": { "sourceGainDb": { "type": "number", "minimum": -60, "maximum": 24 }, "denoise": { "type": "boolean" }, "bridge": { "enum": ["none", "l-cut", "j-cut", "room-tone", "ambience"] } } },
    "transition": { "type": "object", "required": ["kind", "ownerId"], "additionalProperties": false, "properties": { "kind": { "type": "string", "minLength": 1 }, "ownerId": { "type": ["string", "null"] } } },
    "item": { "type": "object", "required": ["itemId", "sourceMediaId", "sourceInSeconds", "sourceOutSeconds", "sourceDurationSeconds", "destinationInSeconds", "destinationOutSeconds", "playbackRate", "colorToken"], "additionalProperties": false, "properties": { "itemId": { "type": "string", "pattern": "^item-[a-zA-Z0-9-]+$" }, "shotId": { "type": "string", "pattern": "^shot-[a-zA-Z0-9-]+$" }, "sourceMediaId": { "type": "string", "pattern": "^media-[a-zA-Z0-9-]+$" }, "sourceKind": { "enum": ["video", "image"] }, "sourceReference": { "$ref": "#/$defs/sourceReference" }, "sourceInSeconds": { "type": "number", "minimum": 0 }, "sourceOutSeconds": { "type": "number", "exclusiveMinimum": 0 }, "sourceDurationSeconds": { "type": "number", "minimum": 0 }, "destinationInSeconds": { "type": "number", "minimum": 0 }, "destinationOutSeconds": { "type": "number", "exclusiveMinimum": 0 }, "playbackRate": { "type": "number", "exclusiveMinimum": 0 }, "playbackRateCurve": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/speedPoint" } }, "transform": { "$ref": "#/$defs/transform" }, "audioPolicy": { "$ref": "#/$defs/audioPolicy" }, "transition": { "$ref": "#/$defs/transition" }, "assetReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^asset-[a-zA-Z0-9-]+$" } }, "motionReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^owner-[a-zA-Z0-9-]+$" } }, "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "colorToken": { "type": "string", "pattern": "^color\\.[a-z][A-Za-z0-9]*$" } } },
    "music": { "type": "object", "required": ["mode"], "additionalProperties": false, "properties": { "mode": { "enum": ["none", "local"] }, "path": { "$ref": "#/$defs/path" }, "trimInSeconds": { "type": "number", "minimum": 0 }, "loop": { "type": "boolean" }, "loopCrossfadeSeconds": { "type": "number", "minimum": 0 }, "fadeInSeconds": { "type": "number", "minimum": 0 }, "fadeOutSeconds": { "type": "number", "minimum": 0 }, "gainDb": { "type": "number", "minimum": -60, "maximum": 24 }, "duckUnderSpeechDb": { "type": "number", "minimum": -60, "maximum": 0 } } },
    "warningDecision": { "type": "object", "required": ["decisionId", "decision", "reason", "timelineRevision", "timelineDigest"], "additionalProperties": false, "properties": { "decisionId": { "type": "string", "pattern": "^decision-[0-9a-f]{16}$" }, "decision": { "enum": ["accept", "reject", "revise"] }, "reason": { "type": "string", "minLength": 1 }, "timelineRevision": { "type": "string", "pattern": "^timeline-[a-zA-Z0-9-]+$" }, "timelineDigest": { "$ref": "#/$defs/digest" } } },
    "integrity": { "type": "object", "required": ["digest", "upstream"], "additionalProperties": false, "properties": { "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "upstream": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } } } }
  }
}
